# Copie para .env (raiz do repositório). O backend o lê a partir de qualquer diretório.
# Nunca versione o .env. Gere os segredos com o comando do README.md.
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgresql+psycopg://attendance:troque-esta-senha@127.0.0.1:5432/attendance
JWT_SECRET=gere-um-segredo-com-pelo-menos-32-caracteres
# Chave Fernet. Faça backup seguro: embeddings cifrados com uma chave perdida ficam inutilizáveis.
EMBEDDING_KEY=gere-com-cryptography-fernet
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Câmera ESP32-S3: somente IPs (sem http://, porta ou caminho). Veja o monitor serial.
CAMERA_HOSTS=["192.168.0.50"]
# CameraWebServer: /capture na porta 80, /stream na porta 81 (server_port + 1).
CAMERA_STREAM_PORT=81
# stream = uma conexão MJPEG (mais FPS); capture = polling de /capture (mais tolerante).
CAMERA_SOURCE=stream
CAMERA_TIMEOUT=5
CAMERA_IDLE_SECONDS=10
MONITOR_MAX_FPS=15
INFERENCE_MAX_FPS=5

# Correspondência. Valores iniciais, NÃO garantias de acurácia: calibre com backend/scripts/calibrate.py.
THRESHOLD=0.55
AMBIGUITY_MARGIN=0.08
UNCERTAIN_BAND=0.05
OBSERVATIONS=3
# Similaridade mínima para marcar Presente sem revisão (após OBSERVATIONS frames). 1 desativa.
AUTO_PRESENT_SCORE=0.7
INTERVAL_SECONDS=2
# Filtros de qualidade do rosto (pontuação de detecção SCRFD, tamanho em pixels, nitidez Laplaciana).
MIN_DETECTION_CONFIDENCE=0.6
MIN_FACE_SIZE=64
ENROLL_MIN_FACE_SIZE=80
MIN_SHARPNESS=40
